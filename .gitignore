# OpenFOAM campaign workspaces are local run data rather than repository
# source.  The existing tracked templates remain tracked; new campaign
# directories must be deliberately force-added if they are intended as
# reusable source templates.
cases/openfoam/**

# Profiling traces and vendored/public reference datasets
precice-profiling/
references/public_precice/
references/public_viv_benchmarks/

# OpenFOAM generated time directories; keep initial conditions such as 0/ and 0.orig/
cases/**/[1-9]*/
cases/**/0.[0-9]*/

