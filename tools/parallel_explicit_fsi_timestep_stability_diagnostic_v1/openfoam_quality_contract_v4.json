{
  "schema_version": "openfoam-numerical-quality-contract-v4",
  "contract_id": "OPENFOAM_QUALITY_V4",
  "frozen_before_run": true,
  "scope": "Future dt=0.0025 s parallel-explicit diagnostic only. Historical V3 evaluations are immutable.",
  "primary_terminal_residual_limit": {"Ux": 0.001, "Uy": 0.001, "p": 0.001},
  "courant_max_limit": 1.0,
  "continuity_global_abs_limit": 0.000001,
  "solve_groups": {
    "fluid_primary": {
      "fields": ["Ux", "Uy", "p"],
      "absolute_tolerance": 1e-08,
      "relative_tolerance": 0.01,
      "max_iterations": 200,
      "iteration_policy": "hard_validity"
    },
    "mesh_motion_auxiliary": {
      "fields": ["cellDisplacementx", "cellDisplacementy"],
      "absolute_tolerance": 1e-08,
      "relative_tolerance": 0.0,
      "iteration_warning_threshold": 200,
      "iteration_policy": "efficiency_warning_only",
      "basis": "fvSolution provides tolerance=1e-8 and relTol=0 but no independently frozen maxIter=200; exact-motion replay retained Mesh OK while requiring more than 200 PCG iterations."
    },
    "flux_correction_auxiliary": {
      "fields": ["pcorr"],
      "absolute_tolerance": 0.01,
      "relative_tolerance": 0.0,
      "max_iterations": 200,
      "iteration_policy": "hard_validity"
    }
  },
  "unknown_solve_policy": "fail_closed",
  "mesh_motion_hard_validity": ["field_present", "finite_initial_and_final_residual", "solver_completed", "final_residual_within_fvSolution_tolerance", "finite_geometry", "tracking_consistent"],
  "legacy_v3_status": "immutable"
}
