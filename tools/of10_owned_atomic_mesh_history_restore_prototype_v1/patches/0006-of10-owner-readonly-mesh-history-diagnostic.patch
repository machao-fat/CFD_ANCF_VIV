+std::string diagnosticHash(const std::string& text)
+{
+    unsigned long long hash = 1469598103934665603ULL;
+    for (const unsigned char c : text)
+    {
+        hash ^= static_cast<unsigned long long>(c);
+        hash *= 1099511628211ULL;
+    }
+
+    std::ostringstream output;
+    output << std::hex << std::setfill('0') << std::setw(16) << hash;
+    return output.str();
+}
+
+template<class FieldType>
+meshHistoryScalarDiagnostic inspectVolume(const FieldType* field)
+{
+    meshHistoryScalarDiagnostic result{false, 0, true, 0, 0, 0, ""};
+    if (!field)
+    {
+        return result;
+    }
+
+    result.present = true;
+    result.size = field->size();
+    result.minValue = GREAT;
+    result.maxValue = -GREAT;
+    forAll(*field, i)
+    {
+        const scalar value = (*field)[i];
+        result.finite = result.finite && std::isfinite(value);
+        result.minValue = min(result.minValue, value);
+        result.maxValue = max(result.maxValue, value);
+    }
+    if (!result.size)
+    {
+        result.minValue = result.maxValue = 0;
+    }
+
+    OStringStream serialized;
+    serialized << *field;
+    result.fingerprint = diagnosticHash(std::string(serialized.str().c_str()));
+    return result;
+}
+
+meshHistoryScalarDiagnostic inspectMeshPhi(const surfaceScalarField* field)
+{
+    meshHistoryScalarDiagnostic result = inspectVolume(field);
+    if (field)
+    {
+        // nOldTimes() only reads the already-existing history chain.
+        result.nOldTimes = field->nOldTimes();
+    }
+    return result;
+}
+
+meshHistoryPointDiagnostic inspectPoints(const pointField* points)
+{
+    meshHistoryPointDiagnostic result{false, 0, true, 0, ""};
+    if (!points)
+    {
+        return result;
+    }
+
+    result.present = true;
+    result.size = points->size();
+    forAll(*points, i)
+    {
+        const point& value = (*points)[i];
+        for (direction d = 0; d < point::nComponents; ++d)
+        {
+            const scalar component = value.component(d);
+            result.finite = result.finite && std::isfinite(component);
+            result.maxComponentAbs = max(result.maxComponentAbs, mag(component));
+        }
+    }
+
+    OStringStream serialized;
+    serialized << *points;
+    result.fingerprint = diagnosticHash(std::string(serialized.str().c_str()));
+    return result;
+}
