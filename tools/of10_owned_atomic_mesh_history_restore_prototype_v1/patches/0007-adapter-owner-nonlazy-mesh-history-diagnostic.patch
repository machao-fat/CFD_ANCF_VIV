+
+void rollbackOwnerPointDiagnostic
+(
+    std::ostream& out,
+    const std::string& name,
+    const Foam::meshHistoryPointDiagnostic& diagnostic
+)
+{
+    out << "\"" << name << "\":{\"classification\":\"OWNER_NON_LAZY\","
+        << "\"present\":" << (diagnostic.present ? "true" : "false")
+        << ",\"count\":" << diagnostic.size
+        << ",\"finite\":" << (diagnostic.finite ? "true" : "false")
+        << ",\"max_component_abs\":" << diagnostic.maxComponentAbs
+        << ",\"canonical_hash_fnv1a64\":\"" << diagnostic.fingerprint << "\"}";
+}
+
+void rollbackOwnerScalarDiagnostic
+(
+    std::ostream& out,
+    const std::string& name,
+    const Foam::meshHistoryScalarDiagnostic& diagnostic
+)
+{
+    out << "\"" << name << "\":{\"classification\":\"OWNER_NON_LAZY\","
+        << "\"present\":" << (diagnostic.present ? "true" : "false")
+        << ",\"count\":" << diagnostic.size
+        << ",\"finite\":" << (diagnostic.finite ? "true" : "false")
+        << ",\"min\":" << diagnostic.minValue
+        << ",\"max\":" << diagnostic.maxValue
+        << ",\"old_time_levels\":" << diagnostic.nOldTimes
+        << ",\"canonical_hash_fnv1a64\":\"" << diagnostic.fingerprint << "\"}";
+}
+
+void rollbackOwnerMeshHistoryDiagnostic
+(
+    std::ostream& out,
+    const Foam::meshHistoryStateDiagnostic& diagnostic
+)
+{
+    out << "\"owner_mesh_history\":{\"classification\":\"OWNER_NON_LAZY\","
+        << "\"moving\":" << (diagnostic.moving ? "true" : "false")
+        << ",\"cur_motion_time_index\":" << diagnostic.curMotionTimeIndex
+        << ",\"cur_time_index\":" << diagnostic.curTimeIndex
+        << ",\"store_old_cell_centres\":"
+        << (diagnostic.storeOldCellCentres ? "true" : "false") << ',';
+    rollbackOwnerPointDiagnostic(out, "old_points", diagnostic.oldPoints);
+    out << ',';
+    rollbackOwnerPointDiagnostic(out, "old_cell_centres", diagnostic.oldCellCentres);
+    out << ',';
+    rollbackOwnerScalarDiagnostic(out, "V0", diagnostic.V0);
+    out << ',';
+    rollbackOwnerScalarDiagnostic(out, "V00", diagnostic.V00);
+    out << ',';
+    rollbackOwnerScalarDiagnostic(out, "meshPhi", diagnostic.meshPhi);
+    out << '}';
+}
 }

